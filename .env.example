# ==============================================================================
# LET'S THINK STUDIO - ENVIRONMENT CONFIGURATION TEMPLATE
# Copy to .env.local for local development. Never commit live secrets.
# ==============================================================================

# Site URL
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase (PostgreSQL, Authentication & Media Storage)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Studio Security & Admin Session Authentication
ADMIN_SESSION_SECRET=
ADMIN_DEFAULT_EMAIL=
ADMIN_DEFAULT_PASSWORD=

# Optional Studio Lead Notifications
STUDIO_NOTIFICATION_EMAIL=

# Optional Analytics & Integration
NEXT_PUBLIC_GA_MEASUREMENT_ID=
NEXT_PUBLIC_STUDIO_WHATSAPP=

